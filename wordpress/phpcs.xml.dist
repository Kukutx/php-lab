<?xml version="1.0"?>
<ruleset name="php-lab-wordpress">
  <description>WordPress Coding Standards for our theme and plugin.</description>
  <file>wp-content/themes/comune-child</file>
  <file>wp-content/plugins/comune-avvisi</file>
  <file>scripts</file>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="p"/>
  <config name="minimum_supported_wp_version" value="6.4"/>
  <config name="testVersion" value="8.1-"/>
  <rule ref="WordPress">
    <!-- File names of classes use the class-*.php convention already; templates are fine as they are. -->
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
  </rule>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="comune-avvisi"/>
        <element value="comune-child"/>
      </property>
    </properties>
  </rule>
</ruleset>
