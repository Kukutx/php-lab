{#
/**
 * @file
 * Main menu as Bootstrap Italia navbar. Only the first level is rendered.
 */
#}
<nav class="navbar navbar-expand-lg has-megamenu" aria-label="Navigazione principale">
  <button class="custom-navbar-toggler" type="button" aria-controls="nav-main" aria-expanded="false" aria-label="Mostra/Nascondi la navigazione" data-bs-toggle="navbarcollapsible" data-bs-target="#nav-main">
    <svg class="icon" aria-hidden="true"><use href="{{ base_path ~ directory }}/node_modules/bootstrap-italia/dist/svg/sprites.svg#it-burger"></use></svg>
  </button>
  <div class="navbar-collapsable" id="nav-main">
    <div class="overlay"></div>
    <div class="menu-wrapper">
      <ul class="navbar-nav">
        {% for item in items %}
          <li class="nav-item">
            <a class="nav-link{{ item.in_active_trail ? ' active' }}" href="{{ item.url }}"{% if item.in_active_trail %} aria-current="page"{% endif %}><span>{{ item.title }}</span></a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</nav>
