# Only custom code, config and Composer files are versioned.
# Everything below is rebuilt by `composer install` / `npm ci`.

/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/web/modules/README.txt
/web/themes/README.txt
/web/profiles/README.txt

# Scaffold files written by drupal/core-composer-scaffold
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.md
/web/autoload.php
/web/example.gitignore
/web/index.php
/web/robots.txt
/web/update.php
/web/web.config
/web/sites/README.txt
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php
/web/sites/default/default.services.yml
/web/sites/default/default.settings.php

# Uploaded files, databases and secrets
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/settings.local.php
/web/sites/*/settings.ddev.php
/web/sites/*/services.yml
*.sql
*.sql.gz
*.sqlite

# Front-end dependencies
node_modules/
