{
    "name": "kukutx/php-lab-pdo-crud",
    "description": "Contacts CRUD in plain PHP 8 (no framework): PDO prepared statements, PSR-4, enums, readonly, PHPUnit.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "phpcs",
        "db:init": "php bin/init-db.php",
        "serve": "php -S 127.0.0.1:8000 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
